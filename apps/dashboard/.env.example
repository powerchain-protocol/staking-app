# Server-side dashboard proxy target. Keep backend secrets out of NEXT_PUBLIC_*.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_NETWORK_LABEL=Devnet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEPLOYMENT_TIER=devnet
# Clerk primary identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_BETTER_AUTH_SOCIAL_PROVIDERS=google,github,apple
NEXT_PUBLIC_AI_ENABLED=true

# Browser websocket endpoint. Must be wss:// in production.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001
NEXT_PUBLIC_REALTIME_ENABLED=true
