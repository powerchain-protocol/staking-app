NODE_ENV=production
DEPLOYMENT_TIER=mainnet-beta
RELEASE_CHANNEL=beta
# Exact acknowledgement required by runtime config before execution readiness can become healthy.
MAINNET_BETA_ACK=POWERCHAIN_MAINNET_BETA
APP_ORIGIN=https://staking.example.com
BACKEND_ORIGIN=https://api-staking.example.com
SOLANA_CLUSTER=mainnet-beta
SOLANA_COMMITMENT=finalized
SOLANA_RPC_URL=
HELIUS_API_KEY=
EXECUTION_ENABLED=false
STATE_CHANGE_REQUIRE_READINESS=true
DATABASE_URL=
SESSION_SECRET=
INTERNAL_WORKER_SECRET=
RECEIPT_SEAL_SECRET=
HELIUS_WEBHOOK_AUTH_TOKEN=
PWRC_MINT=
SOLANA_STAKING_PROGRAM_ID=
SOLANA_GOVERNANCE_PROGRAM_ID=
SOLANA_BONDS_PROGRAM_ID=
SOLANA_BRIDGE_PROGRAM_ID=
PWRC_STAKING_VAULT_TOKEN_ACCOUNT=
PWRC_REWARD_VAULT_TOKEN_ACCOUNT=
PWRC_BRIDGE_RESERVE_TOKEN_ACCOUNT=
PWRC_BRIDGE_RESERVE_AUTHORITY=
SUI_NETWORK=mainnet
SUI_GRPC_URL=
WPWRC_COIN_TYPE=
CCTP_IRIS_URL=https://iris-api.circle.com
CCTP_SOURCE_DOMAIN_ID=5
CCTP_DESTINATION_DOMAIN_ID=
CCTP_USDC_MINT=
JUPITER_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
BIRDEYE_API_KEY=
# Identity / authentication
AUTH_PROVIDER=clerk
REQUIRE_PRIMARY_IDENTITY=true
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
BETTER_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
ACTION_CONFIRMATION_REQUIRED=true
ACTION_CONFIRMATION_TTL_SECONDS=180
ACTION_CONFIRMATION_TOKEN_TTL_SECONDS=180

# Mail
MAIL_ENABLED=false
MAIL_FROM=PowerChain <security@example.com>
RESEND_API_KEY=

# AI / secured compute
AI_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_SIGNING_SECRET=
AI_ALLOWED_MODELS=powerchain-copilot
AI_ALLOWED_TOOLS=portfolio.read,staking.read,rewards.read,governance.read,network.read,bridge.reserve.read,solana.rpc.health,solana.token.validate,rag.search
AI_ALLOW_STATE_CHANGES=false
AI_MAX_INPUT_BYTES=32768
AI_MAX_OUTPUT_BYTES=262144
AI_REQUESTS_PER_MINUTE=20
AI_TIMEOUT_MS=30000


# AI runtime v2 — evidence-first, state changes disabled by default
AI_DEFAULT_PROVIDER=gateway
AI_DEFAULT_MODEL=powerchain-copilot
AI_MAX_TOKENS=2048
AI_RAG_MAX_RESULTS=8
AI_TOOL_TIMEOUT_MS=12000
# Optional direct providers (server-side only)
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_API_KEY=
# Local inference / LoRA
AI_LOCAL_BASE_URL=
AI_LOCAL_API_KEY=
AI_OLLAMA_BASE_URL=
AI_VLLM_BASE_URL=
AI_VLLM_API_KEY=
AI_LORA_ADAPTERS=
# Signed read-only MCP gateway
AI_MCP_GATEWAY_URL=
AI_MCP_SIGNING_SECRET=
AI_ALLOWED_PROVIDERS=gateway
AI_MAX_HISTORY_BYTES=65536

# Authenticated realtime invalidation/status transport. Production requires wss://.
REALTIME_ENABLED=true
REALTIME_PORT=4001
REALTIME_HOST=0.0.0.0
REALTIME_PUBLIC_URL=wss://YOUR_REALTIME_HOST
REALTIME_SIGNING_SECRET=
REALTIME_TOKEN_TTL_SECONDS=60
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_MAX_SUBSCRIPTIONS=16
REALTIME_MAX_CONNECTIONS_PER_SUBJECT=4
REALTIME_MAX_MESSAGES_PER_MINUTE=120
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_EVENT_RETENTION_HOURS=24
