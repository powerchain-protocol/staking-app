# PowerChain Staking v1.0.0 — local/devnet-safe baseline
# Copy to .env.local for local development. Never commit production secrets.

# Runtime / deployment
NODE_ENV=development
DEPLOYMENT_TIER=devnet
RELEASE_CHANNEL=beta
MAINNET_BETA_ACK=
APP_ORIGIN=http://localhost:3001
BACKEND_ORIGIN=http://localhost:4000
API_CORS_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerchain_staking
SESSION_SECRET=change-me-with-at-least-32-random-bytes
INTERNAL_WORKER_SECRET=change-worker-secret
CRON_SECRET=change-cron-secret
RECEIPT_SEAL_SECRET=change-receipt-seal-secret

# Execution stays disabled until health/readiness and all coverage checks pass.
EXECUTION_ENABLED=false
STATE_CHANGE_REQUIRE_READINESS=true
READINESS_ATTESTATION_MAX_AGE_SECONDS=120
REWARD_COVERAGE_MAX_AGE_SECONDS=120
BRIDGE_COVERAGE_MAX_AGE_SECONDS=120
REWARD_VAULT_REQUIRED_FOR_EXECUTION=true
BRIDGE_REQUIRED_FOR_EXECUTION=true

# Solana / Helius — devnet-safe default
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
HELIUS_API_KEY=
SOLANA_COMMITMENT=confirmed
HELIUS_WEBHOOK_REQUIRED=true
HELIUS_WEBHOOK_AUTH_TOKEN=

# Canonical PWRC Token-2022 — explicit deployed values required
PWRC_MINT=
PWRC_DECIMALS=9
PWRC_REQUIRE_REVOKED_MINT_AUTHORITY=true
PWRC_REQUIRE_REVOKED_FREEZE_AUTHORITY=true
PWRC_EXPECTED_TRANSFER_FEE_BPS=200
PWRC_EXPECTED_TRANSFER_FEE_MAX_ATOMIC=
PWRC_REQUIRE_REVOKED_TRANSFER_FEE_CONFIG_AUTHORITY=false
PWRC_REQUIRE_REVOKED_WITHDRAW_WITHHELD_AUTHORITY=false
PWRC_ALLOWED_EXTENSIONS=

# PowerChain Solana programs / vaults — explicit deployment outputs required
SOLANA_STAKING_PROGRAM_ID=
SOLANA_GOVERNANCE_PROGRAM_ID=
SOLANA_BONDS_PROGRAM_ID=
SOLANA_BRIDGE_PROGRAM_ID=
PWRC_STAKING_VAULT_TOKEN_ACCOUNT=
PWRC_REWARD_VAULT_TOKEN_ACCOUNT=
PWRC_BRIDGE_RESERVE_TOKEN_ACCOUNT=
PWRC_BRIDGE_RESERVE_AUTHORITY=

# Sui / wPWRC bridge
SUI_NETWORK=devnet
SUI_GRPC_URL=
WPWRC_COIN_TYPE=
WPWRC_DECIMALS=9
BRIDGE_RESERVE_TOLERANCE_ATOMIC=0
BRIDGE_REQUIRE_NO_DELEGATE=true
BRIDGE_REQUIRE_NO_CLOSE_AUTHORITY=true

# Embedded wallet provider — opt-in and non-custodial
EMBEDDED_WALLETS_ENABLED=false
EMBEDDED_WALLET_PROVIDER_URL=
EMBEDDED_WALLET_PROVIDER_API_KEY=
EMBEDDED_WALLET_PROVIDER_WEBHOOK_SECRET=

# Governance / admin allowlists
GOVERNANCE_PROPOSER_WALLETS=
STAKING_ADMIN_WALLETS=
BOND_ADMIN_WALLETS=

# Intent / workers / operations
PREPARED_TRANSACTION_TTL_SECONDS=90
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_LEASE_SECONDS=120
RECONCILIATION_STALE_SECONDS=180
MAX_OPEN_RECONCILIATION_EXCEPTIONS=10
WORKER_INTERVAL_MS=30000
BOND_UNBONDING_DAYS=7
GOVERNANCE_EXECUTION_DELAY_SECONDS=86400
AUTO_PAUSE_ON_RECONCILIATION_EXCEPTIONS=true
WEBHOOK_MAX_PROCESSING_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=15
INDEXER_BATCH_SIZE=100
INDEXER_LOOP_SECONDS=60
INDEXER_INTERVAL_MS=60000

# Supabase — optional profile/storage/realtime plane; PostgreSQL remains accounting authority
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=powerchain-private

# Solana / Sui liquidity integrations
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
RAYDIUM_API_URL=https://transaction-v1.raydium.io
METEORA_API_URL=
ORCA_API_URL=
CETUS_API_URL=
DEEPBOOK_API_URL=
ENABLED_SWAP_PROVIDERS=JUPITER,RAYDIUM,METEORA,ORCA,CETUS,DEEPBOOK
MAX_SWAP_SLIPPAGE_BPS=300
SWAP_QUOTE_TTL_SECONDS=30

# Price / oracle providers
PYTH_HERMES_URL=https://hermes.pyth.network
BIRDEYE_API_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
COINGECKO_API_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=
PRICE_CACHE_TTL_SECONDS=30
INTEGRATION_HEALTH_TTL_SECONDS=60

# Explorers / metadata
SOLSCAN_BASE_URL=https://solscan.io
SUISCAN_BASE_URL=https://suiscan.xyz
METAPLEX_DAS_URL=

# Circle CCTP V2 — Solana source domain is 5
CCTP_IRIS_URL=https://iris-api-sandbox.circle.com
CCTP_SOURCE_DOMAIN_ID=5
CCTP_DESTINATION_DOMAIN_ID=
CCTP_USDC_MINT=
CCTP_USDC_DECIMALS=6
CCTP_MESSAGE_TRANSMITTER_PROGRAM_ID=CCTPV2Sm4AdWt5296sk4P66VBZ7bEhcARwFaaS9YPbeC
CCTP_TOKEN_MESSENGER_MINTER_PROGRAM_ID=CCTPV2vPZJS2u2BBsUoscuikbYjnpFmbFsvVuJdgUMQe
CCTP_MIN_FINALITY_THRESHOLD=2000
CCTP_FAST_FINALITY_THRESHOLD=1000
CCTP_FEE_BUFFER_BPS=2000
CCTP_MAX_FEE_ATOMIC=
# Optional destination builder. It must never require backend custody of user keys.
CCTP_DESTINATION_PREPARE_URL=
CCTP_DESTINATION_PREPARE_API_KEY=

# Optional ZK verifier — fail closed when enabled but unavailable
ZK_ENABLED=false
ZK_VERIFIER_URL=
ZK_VERIFIER_API_KEY=
# Identity / authentication
AUTH_PROVIDER=clerk
REQUIRE_PRIMARY_IDENTITY=true
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
BETTER_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
ACTION_CONFIRMATION_REQUIRED=true
ACTION_CONFIRMATION_TTL_SECONDS=180
ACTION_CONFIRMATION_TOKEN_TTL_SECONDS=180

# Mail
MAIL_ENABLED=false
MAIL_FROM=PowerChain <security@example.com>
RESEND_API_KEY=

# AI / secured compute
AI_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_SIGNING_SECRET=
AI_ALLOWED_MODELS=powerchain-copilot
AI_ALLOWED_TOOLS=portfolio.read,staking.read,rewards.read,governance.read,network.read,bridge.reserve.read,solana.rpc.health,solana.token.validate,rag.search
AI_ALLOW_STATE_CHANGES=false
AI_MAX_INPUT_BYTES=32768
AI_MAX_OUTPUT_BYTES=262144
AI_REQUESTS_PER_MINUTE=20
AI_TIMEOUT_MS=30000


# AI runtime v2 — evidence-first, state changes disabled by default
AI_DEFAULT_PROVIDER=gateway
AI_DEFAULT_MODEL=powerchain-copilot
AI_MAX_TOKENS=2048
AI_RAG_MAX_RESULTS=8
AI_TOOL_TIMEOUT_MS=12000
# Optional direct providers (server-side only)
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_API_KEY=
# Local inference / LoRA
AI_LOCAL_BASE_URL=
AI_LOCAL_API_KEY=
AI_OLLAMA_BASE_URL=
AI_VLLM_BASE_URL=
AI_VLLM_API_KEY=
AI_LORA_ADAPTERS=
# Signed read-only MCP gateway
AI_MCP_GATEWAY_URL=
AI_MCP_SIGNING_SECRET=
AI_ALLOWED_PROVIDERS=gateway
AI_MAX_HISTORY_BYTES=65536

# AI Runtime v3 reliability
AI_PROVIDER_FALLBACKS=
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_OPEN_SECONDS=60
AI_RAG_CANDIDATE_LIMIT=24
AI_RAG_MIN_EVIDENCE_SCORE=0.30
AI_MAX_TOOL_CALLS=8
AI_EVAL_MIN_PASS_RATE=0.95
AI_EVAL_REQUIRED_FOR_READINESS=false
AI_PROMPT_VERSION=powerchain-ai-runtime-v3
AI_CONVERSATION_RETENTION_DAYS=90
AI_FEEDBACK_RETENTION_DAYS=365

# Authenticated realtime invalidation/status transport. Production requires wss://.
REALTIME_ENABLED=true
REALTIME_PORT=4001
REALTIME_HOST=0.0.0.0
REALTIME_PUBLIC_URL=ws://localhost:4001
REALTIME_SIGNING_SECRET=
REALTIME_TOKEN_TTL_SECONDS=60
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_MAX_SUBSCRIPTIONS=16
REALTIME_MAX_CONNECTIONS_PER_SUBJECT=4
REALTIME_MAX_MESSAGES_PER_MINUTE=120
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_EVENT_RETENTION_HOURS=24
